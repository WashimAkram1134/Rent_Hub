# ─────────────────────────────────────────────────────────────────────────────
# RentHub Backend — Environment Variables
# Copy this to .env and fill in real values
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
APP_NAME=RentHub
APP_ENV=production
APP_VERSION=1.0.0
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000

# ── Keep-Alive (prevents Render free-tier from sleeping) ─────────────────────
# Set this to your deployed backend URL on Render.  The app will ping its own
# /api/v1/health endpoint every 10 minutes so Render never marks it as idle.
# Leave blank in local development — the loop won't start.
SELF_PING_URL=https://your-service-name.onrender.com

# ── Database (Supabase PostgreSQL) ───────────────────────────────────────────
# Get from: https://supabase.com → Project → Settings → Database → Connection String
# Use "Transaction" mode (port 6543) for the app, "Session" mode (port 5432) for Alembic
DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DIRECT_DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# ── Redis (Upstash) ───────────────────────────────────────────────────────────
# Get from: https://console.upstash.com → Your Redis DB → Connect → .env
REDIS_URL=rediss://default:[PASSWORD]@[HOST].upstash.io:6379

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_THIS_TO_RANDOM_32_CHAR_SECRET
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ─────────────────────────────────────────────────────────────────────
# Add your Vercel frontend URL here after deploying
ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:3000

# Frontend base URL (used in email links, redirects)
FRONTEND_URL=https://your-app.vercel.app

# ── Email (optional — leave blank to disable) ─────────────────────────────────
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=postmaster@yourdomain.com
SMTP_PASSWORD=your_smtp_password
EMAIL_FROM=noreply@renthub.com
EMAIL_FROM_NAME=RentHub

# ── Storage ───────────────────────────────────────────────────────────────────
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=/app/uploads
LOCAL_STORAGE_URL=https://your-koyeb-app.koyeb.app/uploads

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=100
AUTH_RATE_LIMIT_PER_MINUTE=20

# ── Pagination ────────────────────────────────────────────────────────────────
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# ── Security ─────────────────────────────────────────────────────────────────
PASSWORD_MIN_LENGTH=8
BCRYPT_ROUNDS=12
