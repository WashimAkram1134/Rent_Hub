# ╔══════════════════════════════════════════════╗
# ║      RentHub Backend — .env.example          ║
# ╚══════════════════════════════════════════════╝
# Copy to .env and fill in real values.
# All sensitive values MUST be replaced in production.

# ─── Application ───────────────────────────────
APP_NAME=RentHub
APP_ENV=development
APP_VERSION=1.0.0
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# ─── Database ──────────────────────────────────
DATABASE_URL=postgresql+asyncpg://renthub:renthub_secret@db:5432/renthub
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ─── Redis ─────────────────────────────────────
REDIS_URL=redis://:redis_secret@redis:6379/0

# ─── JWT ───────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=change_me_generate_with_openssl_rand_hex_32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── CORS ──────────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:80

# ─── Email (SMTP) ──────────────────────────────
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=postmaster@yourdomain.com
SMTP_PASSWORD=your_smtp_password
EMAIL_FROM=noreply@renthub.com
EMAIL_FROM_NAME=RentHub

# ─── Storage ───────────────────────────────────
# Options: local | s3
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=/app/uploads
LOCAL_STORAGE_URL=http://localhost:80/uploads

# AWS S3 (used when STORAGE_BACKEND=s3)
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
AWS_S3_BASE_URL=

# ─── Rate Limiting ─────────────────────────────
RATE_LIMIT_PER_MINUTE=60
AUTH_RATE_LIMIT_PER_MINUTE=10

# ─── Pagination ────────────────────────────────
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# ─── Security ──────────────────────────────────
PASSWORD_MIN_LENGTH=8
BCRYPT_ROUNDS=12
